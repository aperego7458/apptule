# Descomenta la siguiente línea y define la versión mínima de iOS (por ejemplo 12.0 o superior)
platform :ios, '13.0'

# Configuración estándar de Flutter
function_exists = respond_to?(:pod_install_get_dir)
fpath = function_exists ? pod_install_get_dir : File.dirname(File.realpath(__FILE__))
load File.join(fpath, '.symlinks', 'plugins', 'flutter_plugin_loader', 'pkg', 'flutter_plugin_loader.rb') if File.exist?(File.join(fpath, '.symlinks', 'plugins', 'flutter_plugin_loader', 'pkg', 'flutter_plugin_loader.rb'))

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_plugin_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end